# AITgHelper environment template
# Copy this file to .env locally and fill values with your real secrets.
# Never commit .env or files with real tokens/API keys.

# Telegram
TELEGRAM_BOT_TOKEN=

# AI provider: openai or openrouter
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL=

# Application
APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Europe/Moscow

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/aitghelper.sqlite3

# Security / access control
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Use numbers like 123456789, not usernames like @my_username.
ALLOWED_TELEGRAM_USER_IDS=
